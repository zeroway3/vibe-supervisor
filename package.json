{
  "name": "vibe-supervisor",
  "version": "0.0.1",
  "description": "AI 생성 코드에 대한 감독 계층 — 출처 추적과 변조 불가능한 감독 원장(Supervision Ledger)을 생성하는 로컬 git 훅 도구",
  "private": true,
  "type": "module",
  "bin": {
    "vibe-supervisor": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "postcommit": "tsx src/hooks/post-commit.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
